# Waitlist handler config. Copy to .env on the host and fill real values.
# .env is gitignored — never commit real credentials.

# Where submissions are emailed:
MAIL_TO=you@example.com
MAIL_FROM=contato@castelodecampo.com

# SMTP relay (direct VPS port-25 sending gets blocked/spam-filed; use a relay).
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587, SMTP_USER=<gmail>, SMTP_PASS=<app password>
# Hostinger mailbox: SMTP_HOST=smtp.hostinger.com SMTP_PORT=587, user/pass = the mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1

# Anti-spam: min seconds between submits per IP
RATE_SECONDS=20
